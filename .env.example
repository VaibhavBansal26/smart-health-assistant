# Environment variables for Smart Health Assistant.
#
# Copy this file to .env and fill it in. NEVER commit .env (it is git-ignored).
# The Spring Boot backend reads .env automatically when started from backend/ or the repo root.
# In production, set these as real environment variables (or your platform's secrets) instead.
# This is a plain KEY=value file: do not put comments after a value, only on their own lines.

# ---- REQUIRED ----
# At least 32 random characters; the backend refuses to start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
# 32 random bytes, base64. Encrypts appointment reasons and risk-check measurements in the database.
# Generate one with:  openssl rand -base64 32
# Keep a backup somewhere safe, separate from the database: losing this key means losing that data.
DATA_ENCRYPTION_KEY=
# Only while rotating keys: put the OLD key here (and the new one above) so existing rows stay readable.
DATA_ENCRYPTION_KEY_PREVIOUS=

# ---- Server ----
SERVER_PORT=8080
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:4200
# Sessions: a short-lived access token (kept in browser memory) plus a long-lived HttpOnly refresh cookie.
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_DAYS=14
# A refresh token reused within this many seconds is treated as a second browser tab, not theft.
REFRESH_REUSE_GRACE_SECONDS=10
# The refresh cookie is HTTPS-only by default. For local PLAIN-HTTP development set this to false.
COOKIE_SECURE=true
# Strict = never sent on cross-site requests. Use Lax or None only if the frontend and API are on unrelated domains.
COOKIE_SAMESITE=Strict
# Interactive API docs at /swagger-ui.html. Set to false in production.
SWAGGER_ENABLED=true

# ---- HTTPS ----
# true = redirect plain http to https (set it in production).
REQUIRE_HTTPS=false
# Terminate TLS in the app itself (see scripts/dev-cert.sh), or leave false and terminate at a reverse proxy.
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12
# Set to framework ONLY behind a trusted reverse proxy, so client IPs and https are read from X-Forwarded-* headers.
FORWARD_HEADERS_STRATEGY=none

# ---- Login brute-force protection ----
# failed logins per (account, IP) before that pair is locked
AUTH_MAX_FAILED_LOGINS=5
# failed logins per account across ALL IPs (distributed guessing)
AUTH_MAX_FAILED_LOGINS_PER_ACCOUNT=20
AUTH_LOCKOUT_MINUTES=15
# requests per IP to login/register per window
AUTH_IP_MAX_REQUESTS=60
AUTH_IP_WINDOW_MINUTES=15

# ---- Database (defaults to a local H2 file for development) ----
DB_URL=jdbc:h2:file:./data/healthcare;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=

# ---- ML service (Python FastAPI) ----
ML_SERVICE_URL=http://localhost:8000

# ---- AI chat ----
# Leave ANTHROPIC_API_KEY empty to run the chat in scripted demo mode.
ANTHROPIC_API_KEY=
# auto = Claude when a key is set, otherwise demo. Force with: claude or mock
CHAT_PROVIDER=auto
CHAT_MODEL=claude-opus-5-5
# low keeps replies fast. Leave empty for models without effort support.
CHAT_EFFORT=low

# ---- Demo data: DEVELOPMENT ONLY ----
# true creates 12 demo doctors (e.g. asha.verma@clinic.test) on startup.
SEED_DEMO_DATA=false
# Password for all demo doctors, at least 8 characters. Pick your own; it is never stored in the repo.
DEMO_DOCTOR_PASSWORD=

# ---- Accounts and email ----
# log = print emails (verification, reset, invites) to the server log; smtp = really send them.
MAIL_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@smart-health.local
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Frontend address used in the links inside emails.
APP_BASE_URL=http://localhost:4200
# First admin, created at startup if no admin exists. Password must be 12+ characters.
# Remove ADMIN_PASSWORD from the environment once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Patients must verify their email before booking, chatting, risk checks and recommendations.
REQUIRE_VERIFIED_EMAIL=true
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60
INVITE_TOKEN_HOURS=72
# Minimum seconds between emails of the same kind to the same account.
EMAIL_COOLDOWN_SECONDS=60
